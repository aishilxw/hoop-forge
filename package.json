{
  "name": "hoop-forge",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "package:local": "node scripts/release/package.mjs",
    "lint": "prettier --check src tests scripts vite.config.ts",
    "format": "prettier --write src tests scripts vite.config.ts",
    "serve:local": "node scripts/release/serve-local.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
